{
  "name": "fragrances-platform",
  "private": true,
  "workspaces": [
    "apps/server",
    "apps/client"
  ],
  "scripts": {
    "dev": "node scripts/run-dev.mjs",
    "build": "npm run build -w apps/server && npm run build -w apps/client",
    "start": "node scripts/run-start.mjs",
    "start:server": "npm run start -w apps/server",
    "start:client": "npm run dev -w apps/client"
  }
}
